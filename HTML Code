<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Name and Number Display App</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 50px;
        }
        .box-container {
            display: flex;
            gap: 20px;
            margin-top: 20px;
        }
        .box {
            border: 2px solid #333;
            padding: 20px;
            width: 220px;
            min-height: 50px;
            background-color: #f9f9f9;
        }
        input {
            display: block;
            margin-bottom: 10px;
            padding: 8px;
            width: 90%;
        }
        label {
            font-weight: bold;
            display: block;
            margin-top: 10px;
            margin-bottom: 4px;
        }
    </style>
</head>
<body>

    <h2>Enter Name and Number</h2>

    <div class="box-container">
        <!-- Input Box -->
        <div class="box">
            <h3>Input Box</h3>
            <form method="POST">
                <label for="name_input">Name</label>
                <input type="text" id="name_input" name="name_input" placeholder="Type your name" required>

                <label for="number_input">Number</label>
                <input type="number" id="number_input" name="number_input" placeholder="Type a number" required>

                <button type="submit" style="margin-top: 10px;">Submit</button>
            </form>
        </div>

        <!-- Output Box -->
        <div class="box">
            <h3>Output Box</h3>
            <p>
                {% if name and number is not none %}
                    Hello, <strong>{{ name }}</strong>! Your number is: <strong>{{ number }}</strong>
                {% else %}
                    <em>No input submitted yet.</em>
                {% endif %}
            </p>
        </div>
    </div>

</body>
</html>
